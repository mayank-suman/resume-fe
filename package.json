{
  "name": "mayank-suman",
  "private": true,
  "description": "Monorepo for Mayank Suman's LaTeX CV and portfolio website",
  "author": "Mayank Suman",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cv": "npm start -w @mayank/cv",
    "cv:build": "npm run build -w @mayank/cv",
    "cv:watch": "npm run watch -w @mayank/cv",
    "cv:clean": "npm run clean -w @mayank/cv",
    "web": "npm run dev -w @mayank/portfolio",
    "web:build": "npm run build -w @mayank/portfolio",
    "web:preview": "npm run preview -w @mayank/portfolio",
    "build": "npm run cv:build && npm run web:build"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
