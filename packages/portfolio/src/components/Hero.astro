---
import Icon from './Icon.astro';
import type { CV } from '../lib/cv';

interface Props {
  cv: CV;
  cvPdf?: string;
}

const { cv, cvPdf } = Astro.props;
const current = cv.roles.find((role) => role.end.current);
const lines = [cv.firstName, cv.lastName];
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <canvas class="hero__field" data-contour aria-hidden="true"></canvas>
  <div class="hero__inner wrap">
    <h1 class="hero__name display" id="hero-name" data-hero-name>
      <span class="sr-only">{lines.join(' ')}</span>
      {
        lines.map((line, i) => (
          <span class={`hero__line hero__line--${i + 1}`} aria-hidden="true">
            {[...line].map((char) => (
              <span class="hero__char" data-char>
                {char}
              </span>
            ))}
          </span>
        ))
      }
    </h1>

    <div class="hero__body">
      <p class="hero__lede" data-intro>
        Frontend engineer with {cv.yearsOfExperience} years of turning product ideas into fast, accessible
        interfaces.{' '}
        {
          current && (
            <>
              Currently a {current.title.toLowerCase()} at{' '}
              <span class="nowrap">
                <a class="ext" href={current.companyUrl} rel="noopener" target="_blank">
                  {current.company}
                  <Icon name="external" />
                </a>.
              </span>
            </>
          )
        }
      </p>
      <div class="hero__actions" data-intro>
        {
          cv.contact.email && (
            <a class="btn btn--solid" href={`mailto:${cv.contact.email}`}>
              <Icon name="mail" />
              Email me
            </a>
          )
        }
        {
          cvPdf && (
            <a class="btn" href={cvPdf} download>
              <Icon name="download" />
              Download CV
            </a>
          )
        }
      </div>
    </div>

    <dl class="hero__coords meta" data-intro>
      <div>
        <dt class="sr-only">Based in</dt>
        <dd>{cv.contact.address?.replace(/, Canada$/, '')}</dd>
      </div>
      <div>
        <dt class="sr-only">Coordinates</dt>
        <dd>49.28° N, 123.12° W</dd>
      </div>
      <div>
        <dt class="sr-only">Local time</dt>
        <dd><time data-local-time>Pacific time</time></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--nav-h) + 40px);
    padding-bottom: clamp(32px, 5vw, 64px);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    touch-action: pan-y;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: clamp(28px, 4vw, 48px);
    align-items: end;
  }
  .hero__name {
    grid-column: 1 / -1;
    font-size: var(--step-hero);
    line-height: 0.86;
    letter-spacing: -0.035em;
  }
  .hero__line {
    display: block;
    white-space: nowrap;
    /* Clip the rising letters, with room for descenders. */
    overflow: clip;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .hero__line--2 {
    padding-left: 18%;
  }
  .hero__char {
    --wght: 720;
    --wdth: 78;
    display: inline-block;
    font-weight: var(--wght);
    font-stretch: calc(var(--wdth) * 1%);
    will-change: transform;
  }
  .hero__body {
    grid-column: 1 / span 7;
    display: grid;
    gap: 28px;
  }
  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 30em;
  }
  .nowrap {
    white-space: nowrap;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__coords {
    grid-column: 9 / -1;
    justify-self: end;
    text-align: right;
    display: grid;
    gap: 2px;
  }
  .hero__coords dd {
    margin: 0;
  }
  .hero__coords div:first-child dd {
    color: var(--ink);
    font-weight: 560;
  }

  @media (max-width: 860px) {
    .hero__body,
    .hero__coords {
      grid-column: 1 / -1;
    }
    .hero__coords {
      justify-self: start;
      text-align: left;
    }
    .hero__line--2 {
      padding-left: 10%;
    }
  }
  @media (max-width: 600px) {
    .hero__name {
      font-size: 29vw;
    }
  }
</style>
