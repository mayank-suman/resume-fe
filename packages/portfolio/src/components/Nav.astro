---
import Icon from './Icon.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a class="nav__mark" href="#top" aria-label={`${name}, back to top`}>
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path d="M3 24c4-3 7-10 13-10s9 7 13 10" />
        <path d="M3 17c4-3 7-10 13-10s9 7 13 10" />
        <circle cx="16" cy="7" r="3" />
      </svg>
      <span>{name}</span>
    </a>
    <nav aria-label="Sections">
      <ul class="nav__links" role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} data-nav-link>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <span class="nav__indicator" aria-hidden="true"></span>
    </nav>
    <button class="nav__theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
      <Icon name="moon" class="nav__icon nav__icon--moon" />
      <Icon name="sun" class="nav__icon nav__icon--sun" />
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .nav.is-scrolled {
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 1px 0 var(--rule);
  }
  .nav.is-hidden:not(:focus-within) {
    transform: translateY(-100%);
  }
  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    font-family: var(--f-display);
    font-weight: 640;
    font-stretch: 86%;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .nav__mark svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .nav__mark svg path:first-child {
    opacity: 0.45;
  }
  .nav__mark circle {
    fill: var(--sun);
    stroke: none;
    transform-origin: 16px 7px;
    transition: transform 0.5s var(--ease-out);
  }
  .nav__mark:hover circle {
    transform: translateY(-2px) scale(1.25);
  }
  nav {
    position: relative;
  }
  .nav__links {
    display: flex;
    gap: clamp(14px, 2.4vw, 32px);
  }
  .nav__links a {
    display: block;
    padding-block: 8px;
    font-family: var(--f-display);
    font-size: 0.975rem;
    font-weight: 520;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.25s ease;
  }
  .nav__links a:hover,
  .nav__links a[aria-current='true'] {
    color: var(--ink);
  }
  .nav__indicator {
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 1px;
    height: 2px;
    background: var(--sun);
    border-radius: 2px;
    transform-origin: left center;
    opacity: 0;
  }
  .nav__theme {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--rule);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    transition: border-color 0.25s ease;
  }
  .nav__theme:hover {
    border-color: var(--ink);
  }
  .nav__theme :global(.nav__icon) {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.3s ease;
  }
  .nav__theme :global(.nav__icon--sun) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global([data-active-theme='dark']) .nav__theme :global(.nav__icon--sun) {
    opacity: 1;
    transform: none;
  }
  :global([data-active-theme='dark']) .nav__theme :global(.nav__icon--moon) {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  @media (max-width: 720px) {
    .nav__mark span {
      display: none;
    }
    .nav__links {
      gap: 14px;
    }
    .nav__links a {
      font-size: 0.9rem;
    }
  }
  @media (max-width: 400px) {
    .nav__links li:first-child {
      display: none;
    }
  }
</style>
